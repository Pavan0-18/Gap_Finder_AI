# GapFinder AI Environment Configuration

# Application
ENVIRONMENT=development
PROJECT_NAME="GapFinder AI"
API_V1_STR="/api/v1"
SECRET_KEY="gapfinder-super-secret-jwt-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default uses SQLite for standalone local execution.
# For Docker/PostgreSQL with pgvector, use: postgresql+psycopg2://postgres:postgres@localhost:5432/gapfinder
DATABASE_URL=sqlite:///./gapfinder.db

# LLM & Embeddings Provider Configuration
# Supported providers: deterministic (offline/test), gemini, openai
LLM_PROVIDER=deterministic
EMBEDDING_PROVIDER=deterministic
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=1536

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=25

# Demo Account Credentials
DEMO_EMAIL=demo@gapfinder.ai
DEMO_PASSWORD=DemoStudent123!
